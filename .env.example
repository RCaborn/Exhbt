# Copy to .env.local for `npm run dev`, or .dev.vars for `npm run preview` (Cloudflare).
# With none of these set, the app runs in development mode: in-memory store,
# a password kept in memory for /login, a dev sign-in link on the roadmap email,
# and a clearly labelled placeholder roadmap.

# Supabase (live: EU, Paris; preview: London). Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for roadmap generation (claude-haiku-5-5).
ANTHROPIC_API_KEYS=

# Public origin used in email links, e.g. https://exhbt.co.uk
NEXT_PUBLIC_SITE_URL=

# Email via Resend (https://resend.com). Unset: emails go to the dev outbox at /dev/emails.
RESEND_API_KEY=
EMAIL_FROM="Exhbt <hello@your-domain>"

# Signs the "this browser made this roadmap" cookie and unsubscribe links.
# Required in production. Generate with: openssl rand -base64 32
EXHBT_COOKIE_SECRET=

# Set to the number of UK job profiles imported (scripts/import-jobs.mjs prints it).
# At 1,000+ the site says "We've read N UK job profiles"; unset, it uses modest wording.
# In Cloudflare this is a BUILD variable.
NEXT_PUBLIC_JOBS_DATASET_ROLES=

# Set to 1 at launch, once app.exhbt.co.uk reaches this Worker: www sends /login, /roadmap and /auth there.
# Sign-in cookies are per host, so this signs everyone out once. Leave unset until then.
EXHBT_TOOL_HOST=

# Which exhbt editor everyone gets: "page" (the edit-on-page editor) or "classic". Unset, or anything else:
# DEFAULT_EDITOR in lib/editor-kind.ts decides, which is the classic editor until the new one is switched on.
# Set it to page here to work on the new editor. On the live site it is a RUNTIME variable, set in the
# Cloudflare dashboard only when it is needed (HANDOFF.md, "The editor switch").
EXHBT_EDITOR=
