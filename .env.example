# Copy to .env.local for `npm run dev`, or .dev.vars for `npm run preview` (Cloudflare).
# With none of these set, the app runs in development mode: in-memory store,
# a dev sign-in link instead of email, and a clearly labelled placeholder roadmap.

# Supabase (London region). Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for roadmap generation (claude-haiku-5-5).
ANTHROPIC_API_KEY=

# Public origin used in magic-link redirects, e.g. https://exhbt.co.uk
NEXT_PUBLIC_SITE_URL=

# Email via Resend (https://resend.com). Unset: emails go to the dev outbox at /dev/emails.
RESEND_API_KEY=
EMAIL_FROM="Exhbt <hello@your-domain>"

# Signs the "this browser made this roadmap" cookie and unsubscribe links.
# Required in production. Generate with: openssl rand -base64 32
EXHBT_COOKIE_SECRET=
