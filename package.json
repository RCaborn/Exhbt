{
  "name": "exhbt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run check:docs && npm run check:theme && npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme": "npm run astryx -- theme build themes/exhbt/exhbtTheme.ts",
    "check:theme": "npm run astryx -- theme build themes/exhbt/exhbtTheme.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "mammoth": "^1.13.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
